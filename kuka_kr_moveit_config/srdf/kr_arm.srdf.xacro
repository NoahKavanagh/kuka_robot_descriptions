<?xml version="1.0" encoding="utf-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="$(arg robot_name)">
  <xacro:arg name="prefix" default=""/>
  <xacro:property name="robot_name_value" value="$(arg robot_name)"/>
  <xacro:include filename="kr_arm_macro.xacro"/>
  <xacro:kuka_kr_arm prefix="$(arg prefix)"/>
  <xacro:if value="${robot_name_value == 'kr4_r600'}">
    <disable_collisions link1="ashpick_cell_table" link2="zed_camera_center" reason="Never"/>
    <disable_collisions link1="ashpick_wall_left" link2="zed_camera_center" reason="Never"/>
    <disable_collisions link1="ashpick_wall_right" link2="zed_camera_center" reason="Never"/>
    <disable_collisions link1="ashpick_wall_back" link2="zed_camera_center" reason="Never"/>
  </xacro:if>
</robot>
